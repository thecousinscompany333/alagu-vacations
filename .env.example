# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.

# Supabase project URL and anon/publishable key (Supabase → Project Settings → API).
# Safe to expose to the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL (used for sitemap, canonical links and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.your-domain.in

# SERVER-ONLY. Needed only to run scripts/create-admin.mjs on your machine.
# Do NOT add this to Vercel; the web app never uses it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
