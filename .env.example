# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.

# Supabase project URL and anon/publishable key (Supabase → Project Settings → API).
# Safe to expose to the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL (used for sitemap, canonical links and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.your-domain.in

# Cloudflare Turnstile (CAPTCHA) — https://dash.cloudflare.com/?to=/:account/turnstile
# Required in production on booking, admin login, and preview-gate forms.
# Hostname Management (per widget): add alagu-vacations.onrender.com + localhost for local dev with prod keys.
# Error 110200 = domain not listed — not a network block.
# Test keys (always pass, any domain): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# SERVER-ONLY. Needed only to run scripts/create-admin.mjs on your machine.
# Do NOT add this to Vercel; the web app never uses it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OPTIONAL. Place suggestions on the booking form (pickup and destination).
# Without a key the site uses Photon (free public OpenStreetMap search, fair use, no key).
# For more reliable suggestions, create a free Geoapify key (https://myprojects.geoapify.com,
# free plan, no card) and set it here. SERVER-ONLY: never prefix it with NEXT_PUBLIC_.
GEOAPIFY_API_KEY=
