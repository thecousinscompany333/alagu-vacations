# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.

# Supabase project URL and anon/publishable key (Supabase → Project Settings → API).
# Safe to expose to the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site URL (used for sitemap, canonical links and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.your-domain.in

# SERVER-ONLY. Needed only to run scripts/create-admin.mjs on your machine.
# Do NOT add this to Vercel; the web app never uses it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional: WhatsApp alert when someone submits a booking enquiry ---
# Recipient defaults to site_settings.whatsapp (Business details in admin) if unset.
# E.164 digits without +, e.g. 917010998586
# WHATSAPP_NOTIFY_PHONE=917010998586

# Easiest setup (free): https://www.callmebot.com/blog/free-api-whatsapp-messages/
# Message the CallMeBot bot once from the phone that should receive alerts, then paste the apikey here.
# WHATSAPP_CALLMEBOT_APIKEY=your-callmebot-apikey

# Or Meta WhatsApp Cloud API (business number must be on Cloud API; recipient may need to have chatted you first for free-form text).
# WHATSAPP_CLOUD_ACCESS_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
